# ───────────────────────────────────────────────────────────────────────────
# 得茶 Tehcha BMS · environment settings (IR-002)
# Local: copy to .env.   Vercel: Project → Settings → Environment Variables.
# ───────────────────────────────────────────────────────────────────────────

# PostgreSQL. The Neon integration on Vercel sets both of these for you.
#   DATABASE_URL           pooled connection (host contains "-pooler"), used by the API
#   DATABASE_URL_UNPOOLED  direct connection, used by migrations at build time
# Local development: `npm run db:local` prints the URL below.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54329/tehcha
# DATABASE_URL_UNPOOLED=

# Signs the login cookie. Any long random string; changing it signs everyone out.
# If unset, a value derived from DATABASE_URL is used so a first deploy still works.
JWT_SECRET=change-me-to-a-long-random-string

# Public address of the site, used in e-mail links. On Vercel it defaults to the production domain.
APP_URL=http://localhost:5173

# Protects the daily backup job (/api/cron/backup). Vercel sends it automatically when set.
# CRON_SECRET=

# Optional SMTP (EXT-001): e-mail verification for new members and order confirmations.
# Leave MAIL_HOST empty to switch mail off; new accounts are then active straight away.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USER=
# MAIL_PASSWORD=
# MAIL_FROM=得茶 Tehcha <no-reply@your-domain>

# Connections per function instance (default 5).
# DB_POOL_MAX=5

# Redis is not needed: order status uses 3-second polling and the menu is cached by the CDN.
